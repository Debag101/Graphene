#:kivy 2.3.1

MDBoxLayout:
    orientation: 'horizontal'

    MDBoxLayout:
        orientation: 'vertical'
        size_hint_x: 0.3

        MDBoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: "60dp"
            padding: "20dp"

            MDIconButton:
                icon: 'plus-outline'
                font_size: "28sp"
                pos_hint: {"center_x": 0.2, "center_y": 0.94}
                on_release: text_boxes.draw_text_boxes()

                    
        ScrollView: 
            do_scroll_x: False
            do_scroll_y: True

            TextBoxes:
                id: text_boxes
                ccs_obj: ccs 
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: "10dp"
                padding: "10dp"


    CartesianCoordinateSystem:
        id: ccs

